# ============================================================================
# Fraud Detection Application Environment Configuration
# ============================================================================
# Copy this file to .env and update with your actual Supabase credentials
#
# SETUP INSTRUCTIONS:
# 1. Create a new Supabase project at https://supabase.com/dashboard
# 2. Copy your project URL and anon key from Settings > API
# 3. Replace the placeholder values below
# 4. Run the database setup scripts in the /database folder
# ============================================================================

# Supabase Configuration (REQUIRED)
# Get these from: https://supabase.com/dashboard -> Your Project -> Settings -> API
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: Supabase service role key (for admin operations)
# Get from: Settings -> API -> service_role key (keep this secret!)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Development settings
NODE_ENV=development

# Backend API Configuration
# Only needed if running the backend API server
REACT_APP_API_URL=http://localhost:5001

# Optional: Analytics and monitoring
# Add these if you want to integrate analytics
# REACT_APP_ANALYTICS_ID=your_analytics_id
# REACT_APP_SENTRY_DSN=your_sentry_dsn

# ============================================================================
# DEMO USER CREDENTIALS (for testing after database setup)
# ============================================================================
# After setting up the database, create these users in Supabase Auth:
#
# admin@frauddetect.com (Admin Role - Full access)
# analyst@frauddetect.com (Analyst Role - Data analysis)
# investigator@frauddetect.com (Investigator Role - Case management)
# viewer@frauddetect.com (Viewer Role - Read-only dashboard)
#
# Password for all demo users: Demo123!
# ============================================================================

